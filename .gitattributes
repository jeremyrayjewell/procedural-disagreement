# Text is stored and checked out with LF on every platform, so a clone is byte-identical to the
# audited files (assets/MANIFEST.json records their SHA-256).
* text=auto eol=lf
# Except the font folder, kept exactly as GNU distributes it (its OFL text has CRLF line endings).
assets/fonts/** -text

# Large binary media and the recorded lock references go through Git LFS (docs/final_render.md).
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
tests/reference/*.json filter=lfs diff=lfs merge=lfs -text
